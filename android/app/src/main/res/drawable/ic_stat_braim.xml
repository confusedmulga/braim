<!-- Braim notification small icon: a monochrome (white-on-transparent) brain
     inside a circle. Android tints the status-bar small icon, so it must be a
     white silhouette — never the full-colour adaptive launcher icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Circular badge -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M12,2.7 A9.3,9.3 0 1 0 12.001,2.7 Z" />
    <!-- Brain: central stem -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12,7.4 L12,16.4" />
    <!-- Left lobe -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
