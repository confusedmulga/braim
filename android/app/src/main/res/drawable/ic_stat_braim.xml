    <!-- Right lobe (mirror) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,8.1 C13.4,7.1 15.4,7.5 15.8,9 C17.1,9.3 17.3,11.1 16.2,11.7 C17,12.8 16.2,14.4 14.9,14.4 C14.7,15.5 13.2,16.1 12,15.4" />
