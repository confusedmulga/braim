<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own system backup (Android 12+). Braim's data is left in it so a
     new phone can restore it, but the on-device "Backups" zips are kept out of
     the Google-account copy: each zip repeats the whole library, so they would
     push the app past Android's 25 MB cloud quota and stop the notes themselves
     from being backed up. Device-to-device transfer keeps everything except
     Braim Web's linked browsers, which a new phone must pair again, and the
     dictionary, which the app unpacks again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="Backups" />
        <!-- Where the zips go when there is no external storage: the app's
             documents directory (path_provider's app_flutter, under root). -->
        <exclude domain="root" path="app_flutter/Backups" />
        <!-- Braim Web's linked browsers: they belong to this phone only. -->
        <exclude domain="root" path="app_flutter/braim_web_sessions.json" />
        <!-- The dictionary, unpacked from the app on first use (26 MB): alone
             it would push the app past the 25 MB quota. The app unpacks it
             again whenever it's missing. -->
        <exclude domain="file" path="dictionary" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/braim_web_sessions.json" />
        <exclude domain="file" path="dictionary" />
    </device-transfer>
</data-extraction-rules>
