    },
    {
      "id": "12effff1-94b2-4ee5-8bd5-574ce6485192",
      "url": "https://en.wikipedia.org/wiki/Cassini%E2%80%93Huygens",
      "text": "Cassini–Huygens — the twenty-year mission to Saturn and its moons.",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "",
      "authorHandle": "",
      "siteName": "Wikipedia",
      "articleText": "Cassini–Huygens was a space-research mission by NASA, ESA and the Italian Space Agency to study Saturn and its system, including its rings and natural satellites.\n\nLaunched in 1997, it reached Saturn in 2004 and studied the planet until 2017, when it was deliberately flown into Saturn's atmosphere to protect the potentially habitable moons Enceladus and Titan.",
