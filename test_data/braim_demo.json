  "cards": [
    {
      "id": "1ef6d457-5536-4b03-98b1-d10490219a4c",
      "url": "https://www.paulgraham.com/greatwork.html",
      "text": "How to Do Great Work, a long essay on choosing what to work on and sticking with it.",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "Paul Graham",
      "authorHandle": "",
      "siteName": "paulgraham.com",
      "articleText": "My notes on the essay.\n\nPick something you are good at, curious about, and that has room for ambitious work. Curiosity does most of the steering.\n\nGet to the edge of what is known in that area, look for the gaps other people walk past, and chase the ones that seem promising.",
      "fetched": true,
      "enrichAttempts": 0,
      "spaceId": null,
      "pinned": true,
      "archived": false,
      "deletedAt": null,
      "noteTitle": "",
      "blocks": [],
      "createdAt": "2026-09-27T12:20:20.893420",
      "updatedAt": "2026-09-27T12:20:20.893420"
    },
    {
      "id": "d5e3ed1d-7a9c-42f1-a1b8-a5ede4174750",
      "url": "https://waitbutwhy.com/2018/04/picking-career.html",
      "text": "How to Pick a Career (That Actually Fits You)",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "Tim Urban",
      "authorHandle": "",
      "siteName": "Wait But Why",
      "articleText": "My notes on the post.\n\nA career reads less like a ladder and more like a run of experiments, so it pays to run more of them.\n\nDecades of working hours are at stake, which makes a few hours of deliberate thinking about them a bargain.",
      "fetched": true,
      "enrichAttempts": 0,
      "spaceId": null,
      "pinned": false,
      "archived": false,
      "deletedAt": null,
      "noteTitle": "",
      "blocks": [],
      "createdAt": "2026-09-25T12:20:20.893420",
      "updatedAt": "2026-09-25T12:20:20.893420"
    },
    {
      "id": "7fc4213e-fd17-4626-b17f-3f3035e7f2d5",
      "url": "https://en.wikipedia.org/wiki/Cassini%E2%80%93Huygens",
      "text": "Cassini–Huygens, the twenty-year mission to Saturn and its moons.",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "",
      "authorHandle": "",
      "siteName": "Wikipedia",
      "articleText": "My notes on the article.\n\nA joint NASA, ESA and Italian Space Agency probe sent to Saturn. Launched 1997, arrived 2004, spent thirteen years among the rings and moons.\n\nIn 2017 it was steered into Saturn on purpose so it could never crash into, and contaminate, Enceladus or Titan.",
      "fetched": true,
      "enrichAttempts": 0,
      "spaceId": null,
      "pinned": false,
      "archived": false,
      "deletedAt": null,
      "noteTitle": "",
      "blocks": [],
      "createdAt": "2026-09-22T12:20:20.893420",
      "updatedAt": "2026-09-22T12:20:20.893420"
    },
    {
      "id": "385376ce-fd1e-4565-ba5c-68c7cb707ab1",
      "url": "https://x.com/naval/status/1002103360646823936",
      "text": "Seek wealth, not money or status. Wealth is having assets that earn while you sleep.",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "Naval",
      "authorHandle": "@naval",
      "siteName": "",
      "articleText": "",
      "fetched": true,
      "enrichAttempts": 0,
      "spaceId": null,
      "pinned": false,
      "archived": false,
      "deletedAt": null,
      "noteTitle": "",
      "blocks": [],
      "createdAt": "2026-09-19T12:20:20.893420",
      "updatedAt": "2026-09-19T12:20:20.893420"
    },
    {
      "id": "095e815a-f6af-4303-9fb3-b783451aa8fd",
      "url": "https://jamesclear.com/atomic-habits",
      "text": "Atomic Habits, tiny changes, remarkable results.",
      "imageUrl": "",
      "avatarUrl": "",
      "authorName": "James Clear",
      "authorHandle": "",
      "siteName": "jamesclear.com",
      "articleText": "My notes on the book.\n\nSystems beat goals: what you do daily decides the outcome more than what you aim for. Small habits compound.\n\nBuild a habit by making it visible, appealing, low-effort and rewarding; flip each of those to drop one.",
      "fetched": true,
      "enrichAttempts": 0,
      "spaceId": "adf61b3a-d1a8-4a0b-b70f-55e8d6e65572",
      "pinned": false,
      "archived": false,
      "deletedAt": null,
      "noteTitle": "Habits worth stealing",
      "blocks": [
        {
          "id": "e68af260-afa7-440e-8e85-cc2b8213788f",
          "type": "text",
          "text": "Two ideas I keep coming back to: make it obvious, make it easy. The two-minute rule is the one that actually changed my mornings. Pairs well with [[On slow mornings]].",
          "imagePath": ""
        }
      ],
      "createdAt": "2026-09-17T12:20:20.893420",
      "updatedAt": "2026-09-28T12:20:20.893420"
    }
  ],
